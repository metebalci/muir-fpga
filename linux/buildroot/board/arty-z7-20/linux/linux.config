#
# The kernel for the Arty Z7-20's processing system: what the board has, and
# nothing more.  A defconfig, not a full .config: Buildroot runs olddefconfig
# over it and every option not named takes the kernel's default.
#
# The board: two Cortex-A9s, 512 MB of DDR3 of which the top 128 MB is the
# CADR's; UART 0 as the console; GEM 0 with a Realtek RTL8211E; SD 0; Quad
# SPI flash; USB 0 as a host; the Zynq GPIO block, whose EMIO half is where
# the fabric's counters arrive; the devcfg block, through which the fabric
# can be reprogrammed from Linux later.  No display, no keyboard, no PL
# peripherals: the fabric is the CADR.
#
# TWO CHOICES THE STEPPING STONE'S 4.9 KERNEL MADE DIFFERENTLY, and why.
#
# /dev/mem is unrestricted (STRICT_DEVMEM off).  It is how the counters at
# 0xE000A068/0xE000A06C and the CADR's memory are read.  Reading the code
# says it would work even with STRICT_DEVMEM on: ARM uses the generic
# devmem_is_allowed() (lib/devmem_is_allowed.c), which allows any page that
# is not "System RAM", and a no-map region is left out of System RAM by
# arch/arm/kernel/setup.c's request_standard_resources(), which walks
# for_each_mem_range() and that skips NOMAP.  Off is one fewer thing to be
# wrong about.
#
# No power management (PM off, SUSPEND off).  The Zynq GPIO driver
# (drivers/gpio/gpio-zynq.c) gates the block's clock through runtime PM:
# zynq_gpio_runtime_suspend() is clk_disable_unprepare(), and the driver
# drops its reference after probe, so with PM on the block is unclocked
# whenever no GPIO line is requested and the EMIO registers read zero ---
# which is exactly what the 4.9 kernel did, and why docs/boot.md's reading
# begins by turning APER_CLK_CTRL bit 22 back on by hand.  With PM off the
# runtime-PM calls are stubs, the clock the driver takes at probe
# (devm_clk_get_enabled) stays on, and `devmem 0xE000A068` reads the
# counters as it does from the debugger.  Nothing on this board sleeps.  The
# alternative, kept in mind should PM ever be wanted, is to read the lines
# through the driver (gpiochip lines 54..117 are EMIO 0..63; a request
# resumes the block) or to hog one line in the tree.
#
# USB IS A HOST PORT, FOR A KEYBOARD AND A MOUSE.  The Arty Z7-20's USB is
# the processing system's ChipIdea controller (Digilent's tree: usb0 with
# `phy_type = "ulpi"`, `dr_mode = "host"`, its PHY reset on MIO 46), so it is
# Linux's and not the fabric's: the controller in host mode over EHCI
# (USB_CHIPIDEA_HOST), the ULPI PHY as the nop transceiver the mainline
# zybo-z7 tree uses for the same part, HID over USB, and evdev so that a
# keyboard and a mouse are /dev/input/event*.  INPUT_KEYBOARD and INPUT_MOUSE
# stay off: those are the menus for PS/2 and GPIO keyboards and mice, not for
# HID, which registers its own input devices.  USB_ANNOUNCE_NEW_DEVICES puts
# a line on the console when something is plugged in, which is the first
# thing to look for on the board.  No display and no DRM: HDMI on this board
# is the fabric's, not Linux's.
#
# The initramfs arrives as a separate U-Boot ramdisk image, gzip'd
# (BLK_DEV_INITRD, RD_GZIP); there is no root device and no filesystem on
# the card that Linux mounts, so no ext4 and no block layer beyond the card
# itself, which VFAT is kept for.

CONFIG_LOCALVERSION="-cadr"
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ZYNQ=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_AEABI=y
# CONFIG_HIGHMEM is not set
CONFIG_VFP=y
CONFIG_NEON=y
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_NETDEVICES=y
CONFIG_MACB=y
CONFIG_REALTEK_PHY=y
# CONFIG_WLAN is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_XILINX_PS_UART=y
CONFIG_SERIAL_XILINX_PS_UART_CONSOLE=y
CONFIG_DEVMEM=y
# CONFIG_HW_RANDOM is not set
CONFIG_SPI=y
CONFIG_SPI_ZYNQ_QSPI=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ZYNQ=y
# CONFIG_HWMON is not set
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ZYNQ_FPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# CONFIG_STRICT_DEVMEM is not set
