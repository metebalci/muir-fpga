#
# The card's optional file.  THIS IS A TEMPLATE: linux/mksd-buildroot.sh
# writes uEnv.txt from it, filling @SERVERIP@ and @ETHADDR@ from
# linux/local.conf --- gitignored, because this repository is public and a
# machine's address on a private network, or a board's MAC, is not part of
# the project --- and dropping the line for anything local.conf does not set.
#
# WHAT IT DECIDES.  U-Boot's own environment (linux/buildroot/board/arty-z7-20/
# uboot/cadr.env) boots from the card by default: cadr.bit, the tree, zImage
# and the root filesystem off the FAT partition, no network needed.  If this
# file sets `serverip`, the loader takes the network path instead: `dhcp`,
# fetch uEnv.net from that server, and run the netcmd it defines, which
# fetches the same five files over TFTP.  That is this project's own card:
# the files live in /srv/tftp and a change to any of them is a copy and a
# reset.  A card for anyone else simply has no serverip line --- or no
# uEnv.txt at all.
#
# `ethaddr` is the board's MAC.  Mainline U-Boot cannot read it from the
# QSPI flash's OTP area as Digilent's could; without it the board asks DHCP
# with a random address and U-Boot says so.  Set it when a DHCP lease is
# pinned to the board.
serverip=@SERVERIP@
ethaddr=@ETHADDR@

# 1468 rather than the 512-byte default (RFC 2348); U-Boot's lwIP TFTP reads
# this variable (net/lwip/tftp.c).  Harmless on the card path.
tftpblocksize=1468
