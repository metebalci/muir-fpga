/*
 * SPDX-FileCopyrightText: 2026 Mete Balci
 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * U-Boot's default environment for the Arty Z7-20 beside the CADR.
 *
 * This is the whole of what the loader does on its own; bootcmd is
 * `run cadr_boot` (CONFIG_BOOTCOMMAND in uboot.fragment), and everything
 * after the card's uEnv.txt has been imported is decided by that file and by
 * the uEnv.net it fetches --- linux/buildroot/board/arty-z7-20/uEnv.txt.in
 * and uEnv.net say what those hold and why.
 *
 * THE BOARD NEVER BOOTS ANYTHING ELSE.  cadr_boot loops: one attempt, and
 * on any failure a message, ten seconds, and another --- for as long as the
 * server is away.  The 2017 U-Boot on the stepping stone had no `while`, so
 * the card there replaced the fallback's own copy step with `reset`
 * (linux/uEnv.txt.in explains the trick); this U-Boot has hush's loops and
 * `sleep`, so the wait is a loop and the fallback --- the distro boot the
 * generic configuration would run --- is never reached at all.
 *
 * TWO IMPORTS, DHCP BETWEEN THEM, and the order matters twice.  The card's
 * file carries `ethaddr`: this U-Boot cannot read the board's MAC from the
 * QSPI flash's OTP area as Digilent's could, so the address must be in the
 * environment before `dhcp` asks, or the board asks with a random one and
 * gets a different lease every boot.  And the card's file carries
 * `serverip`: U-Boot's lwIP `dhcp` (net/lwip/dhcp.c) writes serverip from
 * the reply unconditionally, where the 2017 build's CONFIG_BOOTP_SERVERIP
 * left it alone, so the file is imported again after `dhcp` to put the TFTP
 * server's address back.  A card written for the stepping stone --- the same
 * three variables plus a `cp_kernel2ram=reset` that nothing here runs ---
 * imports and works unchanged, apart from the MAC it does not carry.
 *
 * ADDRESSES.  Everything below 0x18000000, the CADR's region, and the
 * kernel below 0x08000000: an ARM zImage decompresses itself to
 * (load address & 0xF8000000) + 0x8000, so a kernel loaded at or above
 * 128 MB forgets the memory beneath it ("Ignoring memory range 0x0 -
 * 0x10000000" is how the first card failed).  U-Boot relocates the tree and
 * the ramdisk again before booting, into memory it allocates below its own
 * relocation, which the reserved-memory node in its tree keeps under the
 * CADR's region (common/memtop.c, lib/lmb.c).
 *
 *     cadr_uenv_addr     0x0f000000   uEnv.txt, then uEnv.net (240 MB)
 *     cadr_bit_addr      0x0f800000   cadr.bit, 4 MB (248 MB)
 *     cadr_fdt_addr      0x01f00000   the kernel's tree (31 MB)
 *     cadr_kernel_addr   0x02000000   zImage (32 MB)
 *     cadr_ramdisk_addr  0x04000000   rootfs.cpio.uboot (64 MB)
 */

cadr_uenv_addr=0x0f000000
cadr_bit_addr=0x0f800000
cadr_fdt_addr=0x01f00000
cadr_kernel_addr=0x02000000
cadr_ramdisk_addr=0x04000000

cadr_uenv=
	load mmc 0:1 ${cadr_uenv_addr} uEnv.txt &&
	env import -t ${cadr_uenv_addr} ${filesize}

cadr_try=
	run cadr_uenv && dhcp && run cadr_uenv && run uenvcmd

cadr_boot=
	setenv autoload no;
	while true; do
		run cadr_try;
		echo "cadr: the boot did not happen; trying again in 10 s";
		sleep 10;
	done
