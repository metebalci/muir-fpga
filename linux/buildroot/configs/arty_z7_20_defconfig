#
# Linux for the Arty Z7-20's processing system, beside the CADR in its fabric.
#
#     make buildroot          # from the repository root; see the Makefile
#
# What comes out (output/images/): boot.bin (U-Boot's SPL, the first-stage
# loader that runs the start-up routine), u-boot.img, zImage,
# zynq-arty-z7-20.dtb, rootfs.cpio.uboot.  The first two go on the card with
# uEnv.txt; the rest are served by TFTP.  docs/boot.md, "The Buildroot
# image", has the procedure; every file named here says why it is as it is.
#
# Everything is pinned: Buildroot by version and sha256 in the Makefile, and
# through it U-Boot 2026.01 and Linux 6.19.14 by the hashes Buildroot itself
# carries (boot/uboot/uboot.hash, linux/from-6.17/linux.hash), checked on
# download because BR2_DOWNLOAD_FORCE_CHECK_HASHES is set.  The downloads
# live in vendor/buildroot-dl, gitignored like the BSP and the System 100
# archive, so a rebuild does not refetch.

BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_DL_DIR="$(BR2_EXTERNAL_CADR_PATH)/../../vendor/buildroot-dl"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# A prebuilt cross toolchain rather than one built here: glibc, so the C
# programs the next slice adds meet the libc they would meet anywhere else.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y

# The board on a private LAN: root with the password the stepping stone
# documented, over Dropbear, with the address from DHCP.  docs/boot.md says
# so where the password is used.
BR2_TARGET_GENERIC_HOSTNAME="cadr"
BR2_TARGET_GENERIC_ISSUE="the Arty Z7-20 beside the CADR"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_GETTY_PORT="ttyPS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# The kernel: mainline, the version Buildroot 2026.02 pins, with a config
# that names what this board has and nothing more.  The device tree is ours,
# in the kernel's xilinx/ directory beside zynq-7000.dtsi, which it includes;
# the reserved-memory node arrives by a hook in external.mk.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/linux/linux.config"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/dts"

# The root filesystem: BusyBox (devmem, udhcpc, init), Dropbear, evtest for
# the USB keyboard and mouse (it prints every event a /dev/input/event* node
# delivers, which is how the port is proved on the board), and the skeleton
# of our own programs.  An initramfs as a U-Boot ramdisk image, fetched over
# TFTP beside the kernel, so the card holds no filesystem.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_CADR_TOOLS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
# BR2_TARGET_ROOTFS_TAR is not set

# U-Boot: mainline, the generic Zynq configuration with our fragment over it,
# our device tree, and SPL as the first-stage loader running the start-up
# routine generated from vivado/ps7_init.ops.  The three dts files are copied
# into arch/arm/dts/ before the build; the -u-boot.dtsi is picked up by name.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="xilinx_zynq_virt"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/uboot/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_FORMAT_IMG=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/boot.bin"
BR2_TARGET_UBOOT_ZYNQ=y
BR2_TARGET_UBOOT_ZYNQ_PS7_INIT_FILE="$(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/uboot/ps7_init_gpl.c"
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/dts/xilinx/zynq-arty-z7-20.dts $(BR2_EXTERNAL_CADR_PATH)/board/arty-z7-20/uboot/zynq-arty-z7-20-u-boot.dtsi $(BR2_EXTERNAL_CADR_PATH)/../cadr-reserved.dtsi"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=zynq-arty-z7-20"

# For the card image linux/mksd-buildroot.sh writes at staging time, when the
# TFTP server's address is known.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
