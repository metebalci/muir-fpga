#
# BusyBox applets the boards' init scripts need beyond Buildroot's default
# configuration, for all four boards.
#
# ntpd: the clock by NTP at boot, `ntpd -n -q -p SERVER` from
# S80cadr-disk-packs's `set_the_clock_by_ntp`.  The server side is not built:
# the board answers nobody's time but the machine's, through ozd.
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set
# tunctl: the tap quux0, a persistent tap made IFF_TAP | IFF_NO_PI, for QUUX's
# Ethernet device (S82quux-ethernet-device).  Its -u and -g are not needed:
# root makes the tap and root's program opens it.
CONFIG_TUNCTL=y
# CONFIG_FEATURE_TUNCTL_UG is not set
