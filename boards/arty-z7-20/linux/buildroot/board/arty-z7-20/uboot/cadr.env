/*
 * SPDX-FileCopyrightText: 2026 Mete Balci
 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * U-Boot's default environment for the Arty Z7-20 beside the CADR.
 *
 * THE CARD IS THE PRODUCT; THE NETWORK IS THIS PROJECT'S CONVENIENCE.  Mete
 * decided it: another user of this project cannot be expected to have a
 * TFTP server, so everything the board needs is on the card, and the card
 * boots on its own --- no cable, no DHCP, nothing asked of anyone.  This
 * project's own board keeps taking the same five files from its TFTP server
 * instead, so that a change to any of them is a copy and a reset and the
 * card is never rewritten.  One environment does both, and the card's
 * uEnv.txt decides which by whether it names a server:
 *
 *     serverip set     the network path: dhcp, fetch uEnv.net, run its netcmd
 *     serverip unset   the card path: cadr.bit, the tree, zImage and the
 *                      root filesystem from the FAT partition, then bootz
 *
 * bootcmd is `run cadr_boot` (CONFIG_BOOTCOMMAND in uboot.fragment).  The
 * five files and their names are the same on both paths, and both end in
 * cadr_bootz, so the two boots differ only in where the bytes came from.
 * boards/arty-z7-20/linux/buildroot/board/arty-z7-20/uEnv.txt.in and uEnv.net say what the
 * card's file and the served one hold and why.
 *
 * THE BOARD NEVER BOOTS ANYTHING ELSE.  cadr_boot loops: one attempt, and on
 * any failure a message, ten seconds, and another, for ever.  On the network
 * path that is for as long as the server is away --- it does NOT fall back to
 * the card's own copies, because a card with a server named on it is this
 * project's, and booting stale files silently is the thing this project
 * decided against.  On the card path a failure is a file missing or
 * unreadable, and the message names which.  The 2017 U-Boot had no `while`,
 * so the stepping stone's card replaced the fallback's own copy step with
 * `reset`; this one has hush's loops and `sleep`, and the distro boot the
 * generic configuration would run is never reached at all.
 *
 * uEnv.txt IS OPTIONAL.  A card without one boots the card path with the
 * interface's random MAC (U-Boot says so on the console, and Linux inherits
 * the address through the tree); a card with one may set `ethaddr`, the
 * board's own MAC, which this U-Boot cannot read from the QSPI flash's OTP
 * area as Digilent's could, and `serverip`.  On the network path the file is
 * imported twice with `dhcp` between: lwIP's dhcp (net/lwip/dhcp.c) writes
 * serverip from the reply unconditionally, and the second import puts the
 * card's back.
 *
 * ADDRESSES.  Everything below 0x18000000, the CADR's region, and the
 * kernel below 0x08000000: an ARM zImage decompresses itself to
 * (load address & 0xF8000000) + 0x8000, so a kernel loaded at or above
 * 128 MB forgets the memory beneath it ("Ignoring memory range 0x0 -
 * 0x10000000" is how the first card failed).  U-Boot relocates the tree and
 * the ramdisk again before booting, into memory it allocates below its own
 * relocation, which the reserved-memory node in its tree keeps under the
 * CADR's region (common/memtop.c, lib/lmb.c).
 *
 *     cadr_uenv_addr     0x0f000000   uEnv.txt, then uEnv.net (240 MB)
 *     cadr_bit_addr      0x0f800000   cadr.bit, 4 MB (248 MB)
 *     cadr_fdt_addr      0x01f00000   the kernel's tree (31 MB)
 *     cadr_kernel_addr   0x02000000   zImage (32 MB)
 *     cadr_ramdisk_addr  0x04000000   rootfs.cpio.uboot (64 MB)
 */

cadr_uenv_addr=0x0f000000
cadr_bit_addr=0x0f800000
cadr_fdt_addr=0x01f00000
cadr_kernel_addr=0x02000000
cadr_ramdisk_addr=0x04000000

cadr_bootargs=console=ttyPS0,115200 earlycon

/* The card's file, if there is one; its absence is not a failure. */
cadr_uenv=
	if load mmc 0:1 ${cadr_uenv_addr} uEnv.txt; then
		env import -t ${cadr_uenv_addr} ${filesize};
	else
		echo "cadr: no uEnv.txt on the card; booting from the card";
	fi

/* The last step of both paths: the CADR is in the fabric, the tree, the
 * kernel and the root filesystem are in memory. */
cadr_bootz=
	setenv bootargs ${cadr_bootargs} &&
	bootz ${cadr_kernel_addr} ${cadr_ramdisk_addr} ${cadr_fdt_addr}

/* The card path.  Each load names its file when it fails. */
cadr_card=
	load mmc 0:1 ${cadr_bit_addr} cadr.bit &&
	fpga loadb 0 ${cadr_bit_addr} ${filesize} &&
	load mmc 0:1 ${cadr_fdt_addr} zynq-arty-z7-20.dtb &&
	load mmc 0:1 ${cadr_kernel_addr} zImage &&
	load mmc 0:1 ${cadr_ramdisk_addr} rootfs.cpio.uboot &&
	run cadr_bootz

/* The network path: the served uEnv.net carries netcmd, which fetches the
 * same five files and ends in `run cadr_bootz`. */
cadr_net=
	setenv autoload no;
	dhcp && run cadr_uenv &&
	tftpboot ${cadr_uenv_addr} uEnv.net &&
	env import -t ${cadr_uenv_addr} ${filesize} &&
	run netcmd

cadr_try=
	run cadr_uenv;
	if test -n "${serverip}"; then
		echo "cadr: uEnv.txt names a server; fetching over TFTP";
		run cadr_net;
	else
		run cadr_card;
	fi

cadr_boot=
	while true; do
		run cadr_try;
		echo "cadr: the boot did not happen; trying again in 10 s";
		sleep 10;
	done
