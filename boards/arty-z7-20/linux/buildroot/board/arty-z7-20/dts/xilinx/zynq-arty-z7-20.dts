/*
 * The Arty Z7-20's processing system, as Linux and U-Boot see it.
 *
 * ONE FILE FOR BOTH.  The kernel compiles it from arch/arm/boot/dts/xilinx/
 * and U-Boot from arch/arm/dts/, each beside its own zynq-7000.dtsi and the
 * copy of boards/arty-z7-20/linux/cadr-reserved.dtsi the build puts there; U-Boot adds
 * zynq-arty-z7-20-u-boot.dtsi by name, which marks the three devices its
 * SPL needs.  GPL-2.0-or-later because the blob is embedded in u-boot.img.
 *
 * WHERE EACH FACT COMES FROM.  Mainline has no Arty Z7 tree (Linux 6.19.14
 * arch/arm/boot/dts/xilinx/, U-Boot 2026.01 arch/arm/dts/: seventeen and
 * thirty-odd zynq-* files, none this board); zynq-zybo-z7.dts is the closest
 * shape and is what this is written like.  The board's own facts are
 * Digilent's, from the 2017.4 PetaLinux BSP's generated tree
 * (components/plnx_workspace/device-tree/device-tree-generation/pcw.dtsi
 * and project-spec/meta-user/recipes-bsp/device-tree/files/system-user.dtsi)
 * and from boards/arty-z7-20/vivado/ps7_config.tcl, which is their processing-system
 * configuration verbatim:
 *
 *   the console is UART 0, not the UART 1 of every mainline Zynq board:
 *     PCW_EN_UART0 {1}, PCW_EN_UART1 {0}, MIO 14/15 "UART 0" in the MIO
 *     tree, `serial0 = &uart0` in Digilent's aliases --- ttyPS0 either way;
 *   the PS clock is 50 MHz, not the 33.33 MHz of the zybo and zed:
 *     PCW_CRYSTAL_PERIPHERAL_FREQMHZ {50}, `ps-clk-frequency = <50000000>`;
 *   512 MB of DDR3: PCW_DDR_RAM_HIGHADDR {0x1FFFFFFF}, `reg = <0x0 0x20000000>`;
 *   GEM 0 on RGMII with the PHY's own delays ("rgmii-id"), a Realtek
 *     RTL8211E at MDIO address 1 --- Digilent's `ethernet-phy@0 { reg = <1> }`
 *     with the comment "rtl8211e-vl" --- its reset on MIO 9 (PCW_ENET0_RESET_IO
 *     {MIO 9}, pulsed by the start-up routine's ps7_peripherals_init, so
 *     nothing here has to);
 *   SD 0 with card detect on MIO 47 (PCW_SD0_GRP_CD_IO {MIO 47}), which the
 *     controller reports itself;
 *   Quad SPI with one chip select (PCW_QSPI_GRP_SINGLE_SS_ENABLE {1}); the
 *     flash is named `jedec,spi-nor` and identified by its JEDEC id, because
 *     Digilent's two files disagree on the part (n25q512a in one, s25fl128s
 *     in the other) and the driver does not need to be told;
 *   USB 0 as a host over ULPI, its PHY reset on MIO 46 (Digilent's
 *     `usb-reset = <&gpio0 46 0>`), written as the zybo-z7 writes the same
 *     part.
 *
 * NO PROGRAMMABLE-LOGIC PERIPHERALS.  Digilent's tree carries an amba_pl
 * full of the peripherals of their base design; the fabric here is the
 * CADR, and there is nothing at those addresses.  I2C 0/1 and SPI 0 of the
 * 2017.4 design are off in the current one (PCW_EN_I2C0 {0}, PCW_EN_SPI0 {0})
 * and off here.  No FCLK is enabled: the fabric's clock comes from the pin.
 *
 * THE MODEL AND COMPATIBLE STRINGS ARE DIGILENT'S, so that what
 * /proc/device-tree/model printed on the stepping stone goes on being true.
 *
 * THE MAC ADDRESS IS NOT HERE.  It is private to the board and this file is
 * public; U-Boot puts the `ethaddr` the card supplies into gem0 at boot
 * (fdt_fixup_ethernet, on the ethernet0 alias), which is why the alias is
 * kept and why the kernel and the loader ask DHCP with one address.
 */

/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Zynq Arty Z7 Development Board";
	compatible = "digilent,zynq-artyz7", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart0;
		spi0 = &qspi;
		mmc0 = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	chosen {
		bootargs = "";
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0 {
		#phy-cells = <0>;
		compatible = "usb-nop-xceiv";
		reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;
	};
};

/*
 * The CADR's 128 MB at 0x18000000, `no-map`.  rtl/plumbing/cadr_ddr_map.sv is where
 * the numbers are decided; the dtsi is the same fact in the tree's words.
 * In the kernel it keeps the region out of the linear map and out of
 * "System RAM"; in U-Boot it keeps the loader's own relocation
 * (common/memtop.c) and the fdt and ramdisk it places (lib/lmb.c) below it.
 */
#include "cadr-reserved.dtsi"

&clkc {
	ps-clk-frequency = <50000000>;
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@1 {
		reg = <1>;
	};
};

&qspi {
	status = "okay";
	num-cs = <1>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		m25p,fast-read;
	};
};

&sdhci0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

/*
 * `phys`, NOT the `usb-phy` every mainline Zynq tree still carries, and the
 * reason was measured on this board (10 September, kernel 6.19.14): with
 * `usb-phy` the controller never came up --- ci_hdrc.0 unbound, nothing in
 * dmesg.  drivers/usb/phy/phy-generic.c registers at subsys_initcall and
 * drivers/gpio/gpio-zynq.c at device_initcall, so the PHY's first probe asks
 * for its reset line before gpio0 has a driver and defers; the ChipIdea core
 * (drivers/usb/chipidea/core.c, ci_hdrc_probe) then probes synchronously at
 * device_initcall and looks for a PHY three ways.  Only the `phys` phandle
 * answers -EPROBE_DEFER for a PHY that is not registered yet
 * (phy.c, __of_usb_find_phy); the "any USB2 PHY" fallback that `usb-phy`
 * leaves it with answers -ENODEV, and the probe ends in -ENXIO with no
 * message and no retry.  The binding says the same in its own words
 * (chipidea,usb2-common.yaml: usb-phy "deprecated: true. Use phys instead").
 * No `phy-names`: with CONFIG_GENERIC_PHY on, a name would make the generic
 * lookup wait for a provider this nop PHY is not.
 */
&usb0 {
	status = "okay";
	dr_mode = "host";
	phys = <&usb_phy0>;
};
