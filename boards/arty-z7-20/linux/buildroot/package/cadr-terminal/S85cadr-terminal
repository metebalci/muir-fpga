#
# The screen, the keyboard and the mouse at boot: cadr-terminal serving the
# CADR's display over RFB, and carrying a viewer's keys and pointer back to the
# machine.  **NO OPTION IS PASSED FOR THE INPUT HALF AND NONE IS WANTED**: the
# program finds the I/O board's cables at their own page or says it could not
# and serves the screen read-only, so one init script is right for a bitstream
# with them and for one without.  It listens on port 5900, which a VNC viewer
# reaches as display :0.
#
# S85, after S80cadr-disk-packs: the drive comes present first, so the console
# log reads in the order the machine needs things.  That order is now a real
# dependency as well as a tidy one: the keyboard mapping below is a file on
# the partition S80 mounts.
#
# **IT LISTENS ON EVERY INTERFACE AND HAS NO PASSWORD.**  RFC 6143's `None` is
# the only security type this server offers, so anybody who can reach port
# 5900 on this board sees the screen.  That is deliberate and is the same
# decision the rest of this image already makes --- root logs in with the
# password `root` over Dropbear (boards/arty-z7-20/linux/buildroot/configs/arty_z7_20_defconfig)
# --- because the board is on a private LAN and the screen has to be watched
# from another machine: the board has no display of its own, and a server
# bound to the loopback address would be reachable only by somebody already
# logged in.  `--bind 127.0.0.1` is how that is changed, and then a viewer
# reaches it over an SSH tunnel.
#
# The log goes to the console, which is where the board is watched from
# (docs/boot.md).  start-stop-daemon's -b would send it to /dev/null, so the
# program is told where to write instead --- and `-b` is also why this script
# does not start the program itself but hands it to cadr-common's
# `cadr_daemon`, which looks for it a moment later and prints what it says if
# it is not there.  A flag this program refuses is otherwise a boot that
# prints OK with no screen on it.
#
# **THE KEYBOARD MAPPING IS A FILE AT THE ROOT OF THE CARD, AND IT IS
# OPTIONAL.**  S80cadr-disk-packs mounts the card at /mnt/card before
# this runs, and the card's `fpgarc` is read from the same place for the same
# reason: the card is FAT32, so a laptop with a card reader can edit what is
# on it, which is why the name ends in `.txt`.  The option is passed only
# when the file is there, because `--keyboard-mapping` naming a file that is
# not is a thing to report rather than a boot with no screen --- and only when
# `fpgarc` says nothing about `--keyboard-mapping` itself, which is the rule at
# start() below.  A boot where that mount failed still starts this and takes
# the built-in mapping.
#
# What goes in the file is `key` and `prefix` lines, muir's own format, and
# muir is in this image: `muir --keyboard-mapping-dump` writes the mapping
# this program already has, to edit.  docs/terminal.md has the whole of it.

PROG=/usr/bin/cadr-terminal
# **WHERE THE SCREEN IS SERVED, WRITTEN OUT IN FULL.**  muir's own flag and
# muir's own grammar, one word for the address and the port together
# (cadr/cadr_endpoint.h).  It is written as an endpoint rather than left to the
# program's default so that this script says what it does; a card that names
# `--terminal` in `fpgarc` wins, and this one is then not passed at all.  Every
# interface, because the board has no screen of its own and the paragraph above
# is the whole of why.
ENDPOINT=0.0.0.0:5900
PIDFILE=/var/run/cadr-terminal.pid
# Where the card is mounted, which `S80cadr-disk-packs` is the one thing
# that does.  The card is one FAT32 partition and `fpgarc` is at its root.
CARD=/mnt/card
KEYS_FILE="$CARD/terminal.keyboard.mapping.txt"

# **THE CARD'S ONE FILE OF FLAGS, FILTERED TO THIS PROGRAM'S.**  `fpgarc`
# configures the CADR in the fabric the way `muirrc` beside it configures the
# CADR inside muir: one flag a line, the flag then a space then the rest of
# the line as its argument, `#` a comment, carriage returns stripped.  Several
# programs serve this machine and each refuses a flag it does not know, so the
# file is not passed to any of them whole --- cadr-common's reader hands back
# the lines whose flag is in the list below and nothing else.  Its header is
# the contract and docs/fpgarc.md has every program's list.
RC="$CARD/fpgarc"
FPGARC_SH=/usr/share/cadr/fpgarc.sh
. "$FPGARC_SH"

# And the daemon starter, cadr-common's too: it starts the program, looks for
# it a moment later, and prints what it says when it is not there.  Its header
# is the whole account.
DAEMON_SH=/usr/share/cadr/daemon.sh
. "$DAEMON_SH"

# And the stopper, cadr-common's too: `start-stop-daemon -K` sends SIGTERM and
# returns at once, so `stop` waits for the program to be gone before it says OK
# and before anything after it runs.  Its header is the whole account.
STOP_SH=/usr/share/cadr/stop.sh
. "$STOP_SH"

# **AND THE FAULT BITSTREAM**, cadr-common's fifth file on the target: whether
# the fabric is the one U-Boot loads when the CADR's cannot be loaded, which
# this program must not be started against.  `cadr_fault_stop` says so on the
# console once a boot and is asked first in `start`; its header is the whole
# account, and `docs/board.md` says what the board shows.
FAULT_SH=/usr/share/cadr/fault.sh
. "$FAULT_SH"

# **THE FLAGS THIS PROGRAM OWNS**, read off its own argument list
# (src/cadr-terminal.c).  `--log`, `--no-guard` and `--once` are not here:
# `--log` is `cadr_daemon`'s, which gives every program the same two
# destinations, and the other two are a person's at a prompt.
#
# **`--port` AND `--bind` ARE GONE FROM THE PROGRAM ITSELF**, and that is what
# `--terminal` is.  They were words this program and the serial line both took,
# so no list could claim either and no `fpgarc` line could say where either
# program listened.  muir says the same thing in one word that belongs to one
# program, and now so does this.
FLAGS="--terminal
       --color-terminal
       --color-window
       --keyboard-mapping
       --keyboard-boot
       --keyboard-boot-trace
       --bow
       --window
       --interval-ms
       --no-rre
       --input
       --no-input
       --input-link
       --no-input-link"

start() {
	# Nothing here may reach the fault bitstream: `FAULT_SH` above.
	cadr_fault_stop && return 0
	# **A DEFAULT OF THIS SCRIPT'S IS PASSED ONLY WHERE THE CARD SAYS
	# NOTHING.**  Passing both and letting the program take the last one
	# works, and it put `--terminal 0.0.0.0:5900 --terminal 0.0.0.0:5900`
	# on the board's own command line, which reads as a fault to anybody
	# looking at `ps` to see what the screen is doing.  So the card is
	# asked first and its line is then the only one.  The two defaults here
	# are the endpoint and the mapping file found beside the card's file.
	set --
	fpgarc_has "$RC" --terminal || set -- --terminal "$ENDPOINT"
	if [ -f "$KEYS_FILE" ] && ! fpgarc_has "$RC" --keyboard-mapping; then
		set -- "$@" --keyboard-mapping "$KEYS_FILE"
	fi

	# The card's flags after this script's own, so that a line in `fpgarc`
	# wins over anything this script did pass --- which is muir's rule that
	# a flag given later wins, and the way round somebody editing the card
	# expects.
	[ -f "$RC" ] && eval "set -- \"\$@\" $(fpgarc_args "$RC" $FLAGS)"

	# `--log` is not here and is not the card's to say: where a daemon
	# writes is `cadr_daemon`'s, and it is two places --- the console and a
	# file under /var/log that somebody over ssh can follow.
	cadr_daemon "$PROG" "$PIDFILE" "$@"
}

stop() {
	cadr_stop cadr-terminal "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit $?
