#
# The serial line at boot: cadr-serial offering the far end of the CADR's
# RS-232 cable on TCP port 7641, which `nc <board> 7641` or telnet attaches to.
#
# **IT IS OFF UNLESS THE CARD ASKS FOR IT.**  A `--serial` line in `fpgarc`
# says where the far end is offered, and a card with no such line is a board
# with no serial line and this program not started.  A released card ships that
# line commented out.  The section at start() is the whole of why, and the one
# case that still takes the endpoint below is a boot with no `fpgarc` at all.
#
# **THE PORT IS THE UNIBUS ADDRESS.**  muir gives `--serial` no default on
# purpose, because a number it invented would be one nobody knows.  A daemon
# has to have one, so it is taken the way the debug cable's 7661 is taken from
# DBGOUT's Unibus address: the 2651's first register is `0o764160`
# (sys/doc/unaddr.text), so the port is 7641.  `--serial` changes it.
#
# S86, after S85cadr-terminal and S80cadr-disk-packs: the drive comes present
# first, then the screen, then the line.  Nothing here depends on that order
# --- the register face is there whether or not a pack is --- but a log that
# reads in the wrong order gets read in the wrong order.
#
# **IT LISTENS ON EVERY INTERFACE AND HAS NO PASSWORD.**  Anybody who can
# reach port 7641 on this board is the device on the CADR's null-modem cable
# and can type at the machine.  That is deliberate and is the same decision
# the rest of this image already makes --- root logs in with the password
# `root` over Dropbear
# (boards/arty-z7-20/linux/buildroot/configs/arty_z7_20_defconfig) --- because
# the board is on a private LAN and the line has to be reached from another
# machine.  `--serial 127.0.0.1:7641` is how that is changed, and then the line
# is reached over an SSH tunnel.
#
# The log goes to the console, which is where the board is watched from
# (docs/boot.md).  start-stop-daemon's -b would send it to /dev/null, so the
# program is told where to write instead --- and `-b` is also why this script
# does not start the program itself but hands it to cadr-common's
# `cadr_daemon`, which looks for it a moment later and prints what it says if
# it is not there.  A flag this program refuses is otherwise a boot that prints
# OK with no line on it.

PROG=/usr/bin/cadr-serial
# **WHERE THE FAR END IS OFFERED WHEN THERE IS NO CARD TO SAY.**  muir's own
# flag and muir's own grammar, one word for the address and the port together
# (cadr/cadr_endpoint.h).  It is written as an endpoint rather than left to the
# program's default so that this script says what it does.  It is passed only
# when there is no `fpgarc` at all: a card that names `--serial` says where the
# line is, and a card that does not name it says the line is off.  The
# paragraph at start() is the whole of that.  Every interface, because the
# board has no terminal of its own and the paragraph above is the whole of why.
ENDPOINT=0.0.0.0:7641
PIDFILE=/var/run/cadr-serial.pid
# Where the card is mounted, which `S80cadr-disk-packs` is the one thing
# that does.  The card is one FAT32 partition and `fpgarc` is at its root.
CARD=/mnt/card

# **THE CARD'S ONE FILE OF FLAGS, FILTERED TO THIS PROGRAM'S.**  `fpgarc`
# configures the CADR in the fabric the way `muirrc` beside it configures the
# CADR inside muir: one flag a line, the flag then a space then the rest of
# the line as its argument, `#` a comment, carriage returns stripped.  Several
# programs serve this machine and each refuses a flag it does not know, so the
# file is not passed to any of them whole --- cadr-common's reader hands back
# the lines whose flag is in the list below and nothing else.  Its header is
# the contract and docs/fpgarc.md has every program's list.
#
# S80cadr-disk-packs mounts that partition before this runs.  A boot where the
# mount failed still starts this: it takes the defaults, which are the port
# above and the register face where the fabric puts it.
RC="$CARD/fpgarc"
FPGARC_SH=/usr/share/cadr/fpgarc.sh
. "$FPGARC_SH"

# And the daemon starter, cadr-common's too: it starts the program, looks for
# it a moment later, and prints what it says when it is not there.  Its header
# is the whole account.
DAEMON_SH=/usr/share/cadr/daemon.sh
. "$DAEMON_SH"

# And the stopper, cadr-common's too: `start-stop-daemon -K` sends SIGTERM and
# returns at once, so `stop` waits for the program to be gone before it says OK
# and before anything after it runs.  Its header is the whole account.
STOP_SH=/usr/share/cadr/stop.sh
. "$STOP_SH"

# **AND THE FAULT BITSTREAM**, cadr-common's fifth file on the target: whether
# the fabric is the one U-Boot loads when the CADR's cannot be loaded, which
# this program must not be started against.  `cadr_fault_stop` says so on the
# console once a boot and is asked first in `start`; its header is the whole
# account, and `docs/board.md` says what the board shows.
FAULT_SH=/usr/share/cadr/fault.sh
. "$FAULT_SH"

# **THE FLAGS THIS PROGRAM OWNS**, read off its own argument list
# (src/cadr-serial.c).  `--log`, `--no-guard` and `--once` are not here:
# `--log` is `cadr_daemon`'s, which gives every program the same two
# destinations, and the other two are a person's at a prompt.
#
# **`--port` AND `--bind` ARE GONE FROM THE PROGRAM ITSELF**, and that is what
# `--serial` is.  They were words this program and the screen both took, so no
# list could claim either and no `fpgarc` line could say where either program
# listened.  muir says the same thing in one word that belongs to one program,
# and now so does this.
FLAGS="--serial
       --regs
       --poll-us
       --quiet"

# **A CARD THAT SAYS NOTHING ABOUT `--serial` IS A SERIAL LINE THAT IS OFF,
# AND THAT IS muir'S OWN RULE.**  muir gives `--serial` no default and serves no
# line without it, because a port it invented would be one nobody knows; this
# program is the same program on a board, so it does the same.  A serial line
# is a cable somebody attaches to on purpose and hardly anybody wants, and
# offering an unauthenticated port on every interface for it is not something a
# card should do unasked.
#
# **THE TWO CASES ARE THE CARD SAYING NOTHING AND THERE BEING NO CARD**, and
# they are not the same thing.  A file that is there and has no `--serial` line
# is a card that was asked and said no --- the released card is exactly that,
# with the line present and commented out under the sentence that says what it
# does.  No file at all is nobody having been asked, and then this script's own
# endpoint is what a board has always run on, which is what keeps a boot with
# the card unmounted working the way it did.
#
# Said the other way: the difference between `#--serial 0.0.0.0:7641` and no
# line at all is the difference between a decision and an accident, and only
# the first turns the line off.
start() {
	# Nothing here may reach the fault bitstream: `FAULT_SH` above.
	cadr_fault_stop && return 0
	set --
	if [ -f "$RC" ]; then
		# The card's flags first, which is also what records this
		# program's claim on them: a line read here is a line the
		# unclaimed-lines report at the end of the boot will not name.
		# It happens before the decision below so that the claim is
		# recorded whether or not the line is served.
		eval "set -- $(fpgarc_args "$RC" $FLAGS)"
		# **QUUX HAS NO SERIAL LINE** (contract Q5): the 2651 is on the
		# I/O board, a Unibus slave, and QUUX has no Unibus.  A card that
		# says `--machine quux` carries a QUUX bitstream, and the program
		# is not started, whatever `--serial` says.
		if fpgarc_is_quux; then
			echo "cadr-serial: --machine quux: QUUX has no Unibus and so no serial line; not started."
			return 0
		fi
		if ! fpgarc_has "$RC" --serial; then
			echo "cadr-serial: no --serial in $RC, so the serial line is off."
			echo "cadr-serial: uncomment the --serial line in that file to offer it."
			return 0
		fi
	else
		# **THIS SCRIPT'S OWN ENDPOINT, AND ONLY HERE.**  Passing it
		# alongside a card's line and letting the program take the last
		# one works, and it put `--serial 0.0.0.0:7641 --serial
		# 0.0.0.0:7641` on the board's own command line, which reads as
		# a fault to anybody looking at `ps` to see what the line is
		# doing.
		echo "cadr-serial: no $RC; the line is offered at $ENDPOINT"
		set -- --serial "$ENDPOINT"
	fi

	# `--log` is not here and is not the card's to say: where a daemon
	# writes is `cadr_daemon`'s, and it is two places --- the console and a
	# file under /var/log that somebody over ssh can follow.
	cadr_daemon "$PROG" "$PIDFILE" "$@"
}

stop() {
	cadr_stop cadr-serial "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit $?
