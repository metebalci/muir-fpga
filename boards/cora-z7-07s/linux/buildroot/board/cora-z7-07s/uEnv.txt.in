#
# The card's optional file.  THIS IS A TEMPLATE: one script stages every
# board's card --- boards/arty-z7-20/linux/mksd-buildroot.sh, run with
# BOARD_DIR=boards/cora-z7-07s --- and it writes uEnv.txt from this file,
# filling @SERVERIP@ and @ETHADDR@ from
# boards/cora-z7-07s/linux/local.conf --- gitignored, because this repository is public and a
# machine's address on a private network, or a board's MAC, is not part of
# the project --- and dropping the line for anything local.conf does not set.
#
# WHAT IT DECIDES.  U-Boot's own environment (boards/cora-z7-07s/linux/buildroot/board/cora-z7-07s/
# uboot/cadr_cora.env) boots from the card by default: cadr.bit, the tree, zImage
# and the root filesystem out of the cora-z7-07s/ folder on the FAT partition,
# no network needed.  THE CARD MIRRORS THE SERVER: that folder is named as the
# board's directory under `boards/` is, and holds the same four files under the
# same names as the server's directory for the board.  This file stays at the
# root of the partition beside BOOT.BIN and u-boot.img, because U-Boot imports
# it before any board name is known.  If this
# file sets `serverip`, the loader takes the network path instead: `dhcp`,
# fetch cora-z7-07s/uEnv.net from that server, and run the netcmd it
# defines, which fetches the same five files over TFTP.  That is this
# project's own card: the files live in /srv/tftp/cora-z7-07s --- a directory
# a board, because one server here serves more than one and every board's
# five files carry the same five names --- and a change to any of them is a
# copy and a reset.  A card for anyone else simply has no serverip line --- or no
# uEnv.txt at all.
#
# `ethaddr` is the board's MAC.  Mainline U-Boot cannot read it from the
# QSPI flash's OTP area as Digilent's could; without it the board asks DHCP
# with a random address and U-Boot says so.  Set it when a DHCP lease is
# pinned to the board.
serverip=@SERVERIP@
ethaddr=@ETHADDR@

# 1468 rather than the 512-byte default (RFC 2348); U-Boot's lwIP TFTP reads
# this variable (net/lwip/tftp.c).  Harmless on the card path.
tftpblocksize=1468
