#!/bin/sh
# SPDX-FileCopyrightText: 2026 Mete Balci
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# HP0's QoS AT EVERY FABRIC LOAD, ON QUUX ONLY (contract G3 revision 15,
# A15b.5; QUUX's revision 16 is revision 15's machine with the Ethernet
# device, on the same port): /usr/sbin/quux15-qos.sh writes `AFIFM2`'s RDQOS
# and WRQOS to 0xF and reads them back.  The fabric is loaded by U-Boot just
# before the kernel, so a boot is a fabric load, and this runs once a boot.
#
# **THE FABRIC SAYS WHICH MACHINE IT IS, NOT THE CARD.**  `cadr-console
# machine quux 16` reads entry 21 of the readout window, prints the identity
# line and exits 0 only when the fabric is QUUX, revision 16.  On the CADR,
# on an older QUUX, on a fabric it does not know, with no cadr-console and on
# the fault bitstream (asked first, as every init script that touches the
# fabric does), nothing is written and both registers keep the firmware's 0.
#
# S78: before S79usb-hubs, which may wait 16 s, and before S80cadr-disk-packs
# and every other program that serves the machine.  A boot always goes on:
# a register that does not read back 0xF is said on the console, and the
# exit is 0.
#
# `buildroot_check.py qos` (boards/kria-kr260/linux/) runs this script against
# a stub `devmem` and a stub `cadr-console`, and rewrites the two paths below,
# each on its own line.  `make check` runs it.

FAULT_SH=/usr/share/cadr/fault.sh
QOS_SH=/usr/sbin/quux15-qos.sh

start() {
	. "$FAULT_SH"
	cadr_fault_stop && return 0
	if ! command -v cadr-console > /dev/null 2>&1; then
		echo "quux15-qos: no cadr-console to ask which machine the fabric is; HP0's QoS left as the firmware set it"
		return 0
	fi
	id=$(cadr-console machine quux 16 2>&1)
	rc=$?
	# The identity line, and not the refusal that follows it on any other
	# fabric: a CADR board is not told at every boot that it is not QUUX.
	printf '%s\n' "$id" | grep 'machine: ' | grep -v 'NOT THE MACHINE ASKED FOR'
	if [ "$rc" -ne 0 ]; then
		echo "quux15-qos: the fabric is not QUUX; HP0's QoS left as the firmware set it"
		return 0
	fi
	sh "$QOS_SH" ||
		echo "quux15-qos: HP0's QoS is NOT 0xF on both registers after the write; the machine runs at the priority the line above says"
	return 0
}

case "$1" in
	start|restart|reload) start ;;
	stop) ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
